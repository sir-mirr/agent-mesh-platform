{
  "name": "@agent-mesh/platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "agentMeshSpec": "0.2",
  "description": "Agent Mesh Platform admin web console — React + TypeScript 7 + Vite.",
  "scripts": {
    "dev": "vite --port 3005",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3005",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agent-mesh/contracts": "github:sir-mirr/agent-mesh-contracts#v0.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.1.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
