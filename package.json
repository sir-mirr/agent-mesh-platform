{
  "name": "agent-mesh-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Private monorepo skeleton for the Agent-Mesh channel fabric architecture.",
  "license": "MIT",
  "type": "module",
  "agentMeshSpec": "0.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:hub": "bun packages/hub/src/main.ts",
    "start:http": "bun packages/http/src/main.ts",
    "start:self-reminder": "bun packages/self-reminder/src/main.ts",
    "typecheck": "bun --bun tsc -b tsconfig.base.json --pretty false",
    "typecheck:hub": "bun --bun tsc -p packages/hub/tsconfig.json --pretty false",
    "typecheck:http": "bun --bun tsc -p packages/http/tsconfig.json --pretty false",
    "typecheck:self-reminder": "bun --bun tsc -p packages/self-reminder/tsconfig.json --pretty false",
    "test": "bun test packages/",
    "typecheck:store": "bun --bun tsc -p packages/store/tsconfig.json --pretty false",
    "test:integration": "bun test test/",
    "test:all": "bun test packages/ test/",
    "e2e:harness": "bun scripts/e2e-harness.ts",
    "mail": "bun scripts/mesh-mail.ts",
    "collect-orphans": "bun scripts/collect-orphan-blobs.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/node": "^22.15.21",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@agent-mesh/contracts": "github:sir-mirr/agent-mesh-contracts#v0.8.0",
    "@agent-mesh/store": "workspace:*"
  }
}
