{
  "name": "agent-mesh-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Private monorepo skeleton for the Agent-Mesh channel fabric architecture.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/agent-mesh-core",
    "packages/channel-drivers/*",
    "packages/runtime-adapters/*",
    "packages/shared/*"
  ],
  "scripts": {
    "start:channel-discord": "bun packages/channel-drivers/discord/src/main.ts",
    "start:runtime-codex": "bun packages/runtime-adapters/codex/src/main.ts",
    "start:shared-hub": "bun packages/shared/hub/src/main.ts",
    "start:shared-http": "bun packages/shared/http/src/main.ts",
    "start:shared-self-reminder": "bun packages/shared/self-reminder/src/main.ts",
    "typecheck": "bun --bun tsc -b tsconfig.base.json --pretty false",
    "typecheck:core": "bun --bun tsc -p packages/agent-mesh-core/tsconfig.json --pretty false",
    "typecheck:discord": "bun --bun tsc -p packages/channel-drivers/discord/tsconfig.json --pretty false",
    "typecheck:codex": "bun --bun tsc -p packages/runtime-adapters/codex/tsconfig.json --pretty false",
    "typecheck:synapse-pm-autonomy": "bun --bun tsc -p packages/runtime-adapters/synapse-pm-autonomy/tsconfig.json --pretty false",
    "typecheck:shared-hub": "bun --bun tsc -p packages/shared/hub/tsconfig.json --pretty false",
    "typecheck:shared-http": "bun --bun tsc -p packages/shared/http/tsconfig.json --pretty false",
    "typecheck:shared-self-reminder": "bun --bun tsc -p packages/shared/self-reminder/tsconfig.json --pretty false",
    "typecheck:shared-attachments": "bun --bun tsc -p packages/shared/attachments/tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/node": "^22.15.21",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0"
  }
}
