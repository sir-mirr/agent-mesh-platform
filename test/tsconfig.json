{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `..` for the same reason `scripts/tsconfig.json` uses it: a project that
    // imports a file outside its own directory compiles that file alongside its
    // own, and `noEmit` in the base config rules out project references.
    // `mutation-verdict.ts` is the one such import — the predicate that turns a
    // mutation run into a verdict, which needed a test of its own.
    //
    // Raising it costs nothing here. `outDir` and `rootDir` decide where output
    // lands, and the base config sets `noEmit: true`, so there is no output to
    // place. What `rootDir` still does is decide which sources the project is
    // allowed to contain, which is the whole reason it moved.
    "rootDir": "..",
    "outDir": "dist",
    // The front-end scenarios are `.tsx`.
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../scripts/mutation-verdict.ts",
    "../scripts/lint-preview.ts",
    // The ghost-row repair. It imports nothing from `packages/` on purpose:
    // listing a file that does costs this project everything that file
    // imports, one `TS6307` at a time, which is why the repair is told where
    // the state directory is rather than asking the store.
    "../scripts/ghost-identity.ts",
    // The coverage floor. It imports node builtins and nothing else, for the
    // same reason as the line above.
    "../scripts/coverage.ts",
    // The sentence both mailbox hooks end on. `mailbox-hooks.test.ts` imports
    // it rather than restating it, for the same reason the hooks do: a second
    // copy is a second thing that can disagree.
    "../.claude/hooks/standing-order.ts"
  ]
}
