[Unit]
Description=Agent Mesh Lane — runtime-adapter (%i)
# Lane VM profile (internal-mesh v0.1).
#
# Selects the adapter binary by RUNTIME_KIND env (codex|claude) read
# from /etc/agent-mesh/lane/<lane-id>.env. For codex the runtime is
# expected to be served by agent-mesh-lane-codex-app-server@%i.service
# on the same VM.
After=network-online.target agent-mesh-lane-codex-app-server@%i.service
Wants=network-online.target
PartOf=agent-mesh-lane@%i.target
ConditionPathExists=/srv/agent-mesh-platform/packages/runtime-adapters
ConditionPathExists=/etc/agent-mesh/lane/%i.env

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/agent-mesh-platform
Environment=BUN_INSTALL=/home/ubuntu/.bun
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_MESH_PLATFORM_HOME=/srv/agent-mesh-platform
EnvironmentFile=-/etc/agent-mesh/lane/%i.env
EnvironmentFile=-/etc/agent-mesh/lane/%i.secret
ExecStart=/bin/sh -lc 'exec /home/ubuntu/.bun/bin/bun "packages/runtime-adapters/${RUNTIME_KIND:?RUNTIME_KIND must be set in /etc/agent-mesh/lane/%i.env}/src/main.ts"'
Restart=always
RestartSec=3

[Install]
WantedBy=agent-mesh-lane@%i.target
