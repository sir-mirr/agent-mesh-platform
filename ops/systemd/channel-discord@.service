[Unit]
Description=Agent Mesh Discord Channel Driver (%i)
After=network-online.target agent-mesh-hub-lab.service
Wants=network-online.target
ConditionPathExists=/srv/agent-mesh-platform/packages/channel-drivers/discord/src/main.ts

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/agent-mesh-platform
Environment=BUN_INSTALL=/home/ubuntu/.bun
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_MESH_PLATFORM_HOME=/srv/agent-mesh-platform
EnvironmentFile=-/srv/agent-mesh-lab/env/shared/common.env
EnvironmentFile=-/srv/agent-mesh-lab/secrets/%i.env
EnvironmentFile=-/srv/agent-mesh-lab/env/%i/discord.env
ExecStart=/home/ubuntu/.bun/bin/bun packages/channel-drivers/discord/src/main.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
