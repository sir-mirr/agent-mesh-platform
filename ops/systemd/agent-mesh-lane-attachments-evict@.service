[Unit]
Description=agent-mesh lane attachments cache eviction (lane=%i)
Documentation=https://github.com/yongwang-mesh/agent-mesh-platform SPEC.md#15.4
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=LANE_ID=%i
# Operator MAY override via /etc/default/agent-mesh-lane-attachments-evict@<lane-id>
EnvironmentFile=-/etc/default/agent-mesh-lane-attachments-evict@%i
ExecStart=/srv/agent-mesh-platform/ops/bin/lane-attachments-evict.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
