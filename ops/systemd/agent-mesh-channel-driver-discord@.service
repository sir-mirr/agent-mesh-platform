[Unit]
Description=Agent Mesh Lane — Discord channel driver (%i)
# Lane VM profile (internal-mesh v0.1).
# Only enable this unit when CHANNEL_KIND=discord. Additional channel
# drivers (e.g. telegram, slack) SHOULD ship as parallel
# agent-mesh-channel-driver-<kind>@.service templates and be wired
# into agent-mesh-lane@%i.target the same way.
After=network-online.target agent-mesh-runtime-adapter@%i.service
Wants=network-online.target
PartOf=agent-mesh-lane@%i.target
ConditionPathExists=/srv/agent-mesh-platform/packages/channel-drivers/discord/src/main.ts
ConditionPathExists=/etc/agent-mesh/lane/%i.env

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/agent-mesh-platform
Environment=BUN_INSTALL=/home/ubuntu/.bun
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_MESH_PLATFORM_HOME=/srv/agent-mesh-platform
EnvironmentFile=-/etc/agent-mesh/lane/%i.env
EnvironmentFile=-/etc/agent-mesh/lane/%i.secret
ExecStart=/home/ubuntu/.bun/bin/bun packages/channel-drivers/discord/src/main.ts
Restart=always
RestartSec=3

[Install]
WantedBy=agent-mesh-lane@%i.target
