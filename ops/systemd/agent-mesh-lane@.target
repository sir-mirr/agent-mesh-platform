[Unit]
Description=Agent Mesh Lane (%i) — runtime-adapter + channel-driver(s)
# Aggregator target. Enable/start this to bring the whole lane up.
# Individual units (codex-app-server, runtime-adapter, channel-driver)
# are wired with PartOf=/BindsTo= via their own unit files so that
# `systemctl stop agent-mesh-lane@<id>.target` stops the whole stack.
Wants=agent-mesh-runtime-adapter@%i.service
Wants=agent-mesh-channel-driver-discord@%i.service
After=agent-mesh-runtime-adapter@%i.service agent-mesh-channel-driver-discord@%i.service

[Install]
WantedBy=multi-user.target
