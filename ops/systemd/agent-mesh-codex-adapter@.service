[Unit]
Description=Agent Mesh Codex Runtime Adapter (%i)
After=network-online.target agent-mesh-hub-lab.service agent-mesh-self-reminder-lab.service codex-app-server@%i.service channel-discord@%i.service
Requires=agent-mesh-hub-lab.service codex-app-server@%i.service channel-discord@%i.service
Wants=network-online.target
ConditionPathExists=/srv/agent-mesh-platform/packages/runtime-adapters/codex/src/main.ts

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/agent-mesh-platform
Environment=BUN_INSTALL=/home/ubuntu/.bun
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.nvm/versions/node/v24.14.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_MESH_PLATFORM_HOME=/srv/agent-mesh-platform
EnvironmentFile=-/srv/agent-mesh-lab/env/shared/common.env
EnvironmentFile=-/srv/agent-mesh-lab/env/%i/adapter.env
ExecStart=/home/ubuntu/.bun/bin/bun packages/runtime-adapters/codex/src/main.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
