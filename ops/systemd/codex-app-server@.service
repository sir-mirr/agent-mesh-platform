[Unit]
Description=Codex app-server (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/agent-mesh-platform/package.json

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/agent-mesh-platform
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.14.1/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/srv/agent-mesh-lab/env/shared/common.env
EnvironmentFile=-/srv/agent-mesh-lab/env/%i/app-server.env
ExecStart=/bin/sh -lc 'exec codex app-server --listen "$CODEX_APP_SERVER_LISTEN_URL"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
