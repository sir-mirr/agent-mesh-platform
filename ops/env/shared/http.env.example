AGENT_MESH_STATE_DIR=/srv/agent-mesh-lab/state/shared
AGENT_MESH_HTTP_PORT=3200
AGENT_MESH_HUB_URL=ws://127.0.0.1:3100/ws
# Mesh identity pinged when a new GitHub user needs approval. Unset means the
# request only shows up in GET /api/v1/admin/pending.
AGENT_MESH_ADMIN_NOTIFY_IDENTITY=

# **Without this the service refuses to start**, which is what it should do —
# signing sessions with a default would mean anyone who has read the source can
# forge them. It was absent from this file, so a deployment assembled from the
# env layout here failed on its first start with a message about a variable
# nothing had told the administrator to set. Any long random string; this one is
# a placeholder and must be replaced.
JWT_SECRET=replace-me-with-a-long-random-string

# The proxy block in § 8 of docs/running-locally.md must name the port above.
# That block prints `127.0.0.1:3000`, which is the document's own local port and
# not this one — the document says so in prose, and prose beside a block that
# can be copied loses to the block.
