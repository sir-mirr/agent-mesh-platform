CODEX_ADAPTER_IDENTITY=test-codex1-codex-adapter
CODEX_PROXY_FOR=test-codex1
CODEX_TARGET_AGENT=test-codex1
CODEX_URL=ws://127.0.0.1:4501
CODEX_CWD=/srv/agent-mesh-platform
CODEX_ADAPTER_HTTP_PORT=4601
CODEX_ADAPTER_HTTP_TOKEN=change-me-test-codex1-ingress
CHANNEL_DISCORD_URL=http://127.0.0.1:4611
CHANNEL_DISCORD_TOKEN=change-me-test-codex1-discord
CODEX_ADAPTER_STATE_PATH=/srv/agent-mesh-lab/state/codex/test-codex1/state.json
RUNTIME_INSTRUCTIONS_PATH=/srv/agent-mesh-platform/instructions/test-codex1.txt
RUNTIME_HANDOFF_DIR=/srv/agent-mesh-lab/handoffs/test-codex1
RUNTIME_ROTATION_ENABLED=true
RUNTIME_ROTATION_TURN_THRESHOLD=25
# Mesh identity that receives runtime operator alerts (codex auth failures,
# stuck turns). Unset means those alerts are logged only.
RUNTIME_OPERATOR_IDENTITY=
