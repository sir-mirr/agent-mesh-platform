# /etc/agent-mesh/lane/<lane-id>.env  — example
#
# Lane VM profile (internal-mesh v0.1). Copy to
#   /etc/agent-mesh/lane/<lane-id>.env
# and edit. Secrets MUST live in a sibling <lane-id>.secret file
# with mode 0600 (see lane.secret.example).

# ── hub / identity ────────────────────────────────────────────────
HUB_URL=ws://core-vm.internal:3100/ws
LANE_IDENTITY=example-lane-1

# ── runtime selection (codex | claude) ────────────────────────────
RUNTIME_KIND=codex
# Local URL of the runtime served on this lane VM.
RUNTIME_ENDPOINT=http://localhost:4500

# ── channel selection ─────────────────────────────────────────────
CHANNEL_KIND=discord

# ── codex app-server (when RUNTIME_KIND=codex) ────────────────────
CODEX_APP_SERVER_LISTEN_URL=ws://127.0.0.1:4501
CODEX_SANDBOX=danger-full-access
CODEX_APPROVAL_POLICY=never

# ── runtime-adapter (codex flavour shown; see test-codex* for full list) ──
CODEX_ADAPTER_IDENTITY=example-lane-1-codex-adapter
CODEX_PROXY_FOR=example-lane-1
CODEX_TARGET_AGENT=example-lane-1
CODEX_URL=ws://127.0.0.1:4501
CODEX_CWD=/srv/agent-mesh-platform
CODEX_ADAPTER_HTTP_PORT=4600
CHANNEL_DISCORD_URL=http://127.0.0.1:4610
CODEX_ADAPTER_STATE_PATH=/var/lib/agent-mesh/lane/example-lane-1/codex-state.json
RUNTIME_INSTRUCTIONS_PATH=/srv/agent-mesh-platform/instructions/example-lane-1.txt
RUNTIME_HANDOFF_DIR=/var/lib/agent-mesh/lane/example-lane-1/handoffs
RUNTIME_ROTATION_ENABLED=true
RUNTIME_ROTATION_TURN_THRESHOLD=25

# ── channel-driver (discord) ──────────────────────────────────────
DISCORD_DRIVER_IDENTITY=example-lane-1
ACCESS_JSON_PATH=/var/lib/agent-mesh/lane/example-lane-1/discord/access.json
ATTACHMENTS_DIR=/var/lib/agent-mesh/lane/example-lane-1/attachments
CHANNEL_INGRESS_URL=http://127.0.0.1:4600/ingress/channel
DISCORD_DRIVER_HTTP_PORT=4610
