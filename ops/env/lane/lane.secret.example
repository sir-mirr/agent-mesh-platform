# /etc/agent-mesh/lane/<lane-id>.secret  — example
#
# Copy to /etc/agent-mesh/lane/<lane-id>.secret and `chmod 0600`.
# install-lane.sh enforces 0600 on this file.

# Discord bot token for this lane's channel-driver.
DISCORD_BOT_TOKEN=replace-me

# Intra-lane HTTP shared secrets (adapter <-> driver loopback).
# Generate fresh per lane; both sides must match.
CODEX_ADAPTER_HTTP_TOKEN=replace-me
CHANNEL_DISCORD_TOKEN=replace-me
CHANNEL_INGRESS_TOKEN=replace-me
DISCORD_DRIVER_HTTP_TOKEN=replace-me
