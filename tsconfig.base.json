{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "bun",
      "node"
    ],
    "paths": {
      "@agent-mesh/hub": [
        "./packages/hub/src/main.ts"
      ],
      "@agent-mesh/http": [
        "./packages/http/src/main.ts"
      ],
      "@agent-mesh/self-reminder": [
        "./packages/self-reminder/src/main.ts"
      ],
      "@agent-mesh/store": [
        "./packages/store/src/index.ts"
      ],
      "@agent-mesh/platform-web": [
        "./packages/platform-web/src/main.tsx"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./packages/store/tsconfig.json"
    },
    {
      "path": "./packages/hub/tsconfig.json"
    },
    {
      "path": "./packages/http/tsconfig.json"
    },
    {
      "path": "./packages/self-reminder/tsconfig.json"
    },
    {
      "path": "./packages/platform-web/tsconfig.json"
    },
    {
      "path": "./test/tsconfig.json"
    }
  ]
}
