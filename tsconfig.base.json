{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@agent-mesh/core": ["packages/agent-mesh-core/src/index.ts"],
      "@agent-mesh/channel-discord": ["packages/channel-drivers/discord/src/index.ts"],
      "@agent-mesh/runtime-codex": ["packages/runtime-adapters/codex/src/index.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/agent-mesh-core/tsconfig.json" },
    { "path": "./packages/channel-drivers/discord/tsconfig.json" },
    { "path": "./packages/runtime-adapters/codex/tsconfig.json" }
  ]
}
