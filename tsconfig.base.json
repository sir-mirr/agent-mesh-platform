{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun", "node"],
    "paths": {
      "@agent-mesh/shared-hub": ["./packages/shared/hub/src/main.ts"],
      "@agent-mesh/shared-http": ["./packages/shared/http/src/main.ts"],
      "@agent-mesh/shared-self-reminder": ["./packages/shared/self-reminder/src/main.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/shared/hub/tsconfig.json" },
    { "path": "./packages/shared/http/tsconfig.json" },
    { "path": "./packages/shared/self-reminder/tsconfig.json" }
  ]
}
